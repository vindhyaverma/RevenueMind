# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to "true" to run with in-memory SQLite, pre-seeded data, and simulated
# Razorpay responses. No external services required.
DEMO_MODE=true

# ─── Database ────────────────────────────────────────────────────────────────
# Only needed when DEMO_MODE=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=merchantmind
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/merchantmind

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Required for AI features. Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Use TEST keys only (rzp_test_*). Get from https://dashboard.razorpay.com
# When keys are absent, the backend simulates order creation.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── App Config ──────────────────────────────────────────────────────────────
MANDATE_SECRET_KEY=your_secret_key_for_hmac_signatures
LOG_LEVEL=INFO
